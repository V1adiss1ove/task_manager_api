# Автоопределение текстовых файлов, нормализация к LF в репозитории
* text=auto

# LF для конкретных типов
*.py   text eol=lf
*.pyi  text eol=lf
*.ini  text eol=lf
*.mako text eol=lf
*.cfg  text eol=lf
*.toml text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-скрипты — CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Бинарники
*.png  binary
*.jpg  binary
*.pdf  binary
*.xlsx binary